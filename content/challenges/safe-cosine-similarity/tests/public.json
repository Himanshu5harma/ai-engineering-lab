[
  {
    "name": "Orthogonal vectors",
    "kwargs": {
      "a": [
        1,
        0
      ],
      "b": [
        0,
        1
      ]
    },
    "expected": 0.0
  },
  {
    "name": "Parallel vectors",
    "kwargs": {
      "a": [
        1,
        2
      ],
      "b": [
        2,
        4
      ]
    },
    "expected": 1.0
  },
  {
    "name": "Opposite direction",
    "kwargs": {
      "a": [
        1,
        -1
      ],
      "b": [
        -1,
        1
      ]
    },
    "expected": -1.0
  },
  {
    "name": "Zero vector",
    "kwargs": {
      "a": [
        0,
        0
      ],
      "b": [
        3,
        4
      ]
    },
    "expected": 0.0
  },
  {
    "name": "Mismatched dimensions",
    "kwargs": {
      "a": [
        1
      ],
      "b": [
        1,
        2
      ]
    },
    "raises": "ValueError"
  },
  {
    "name": "Empty vectors",
    "kwargs": {
      "a": [],
      "b": []
    },
    "raises": "ValueError"
  }
]
